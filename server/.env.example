NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:8081
MONGODB_URI=mongodb://127.0.0.1:27017/justspai
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Payment gateway configuration hooks (provider-specific values should be stored as secrets)
PAYMENT_GATEWAY=razorpay
PAYMENT_KEY_ID=replace-with-provider-key-id
PAYMENT_KEY_SECRET=replace-with-provider-key-secret
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
